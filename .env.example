PORT=3000
# 生产环境允许访问的来源，多个来源用英文逗号分隔。本地开发时可不设置。
CORS_ORIGIN=http://localhost:5173
# 仅当前端和 API 分开托管时供 web 客户端使用。
VITE_SERVER_URL=

# 微信内容安全识别（gameMsgSecCheck）凭据，仅服务端使用。
# 配置后，微信端（小游戏/小程序）的昵称、词语、聊天内容将调用微信官方接口校验；
# 未配置时回退本地词库，web 端始终使用本地词库。
WECHAT_APPID=
WECHAT_APPSECRET=
# 额外本地敏感词，逗号或竖线分隔（web 端与微信接口不可用时生效）。
SENSITIVE_WORDS=
