PORT=3000
# 生产环境允许访问的来源，多个来源用英文逗号分隔。本地开发时可不设置。
CORS_ORIGIN=http://localhost:5173
# 仅当前端和 API 分开托管时供 web 客户端使用。
VITE_SERVER_URL=

# 微信云托管「开放接口服务」云调用配置。
# 云调用免 access_token，openid 由云托管通过请求头 x-wx-openid 自动注入。
# 使用前需在控制台「云调用-微信令牌权限配置」开通：
#   /wxa/game/content_spam/msg_sec_check
# 并在开启开关后重新构建服务版本。
# 可选：资源复用时指定归属小程序 appid（会作为 from_appid 附加）。
WECHAT_FROM_APPID=
# 可选：覆盖微信 API 域名，默认 http://api.weixin.qq.com（云调用内网地址）。
WECHAT_API_BASE=
# 额外本地敏感词，逗号或竖线分隔（web 端与云调用不可用时生效）。
SENSITIVE_WORDS=
